# ==============================================================================
# Root-level ignores. Framework-specific rules live in subdirectory .gitignore
# files (web/.gitignore for SvelteKit).
# ==============================================================================

# --- OS ---
.DS_Store
._*
Thumbs.db

# --- Secrets & environment ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.netrc
.npmrc.local
/.aws/
/.ssh/
/secrets/
# Runtime databases, exports, and backups contain credentials or site data.
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.dump
*.sql.gz
*.sql.zst
*.bak
/backups/

# Local task state and credential scanner reports.
/.agents/
/.codex/
/.claude/
/gitleaks*.json
/gitleaks*.sarif

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*~

# --- Engine state (DATA_DIR default) ---
/data/

# --- Logs & temp ---
*.log
tmp/

# --- Go build output ---
/bin/
/dist/
# A plain `go build ./cmd/<name>` drops the binary at the repo root.
/pressod
*.test
*.out
coverage.*

# --- Go workspace files ---
go.work
go.work.sum

# --- Embedded web UI build (copied from web/build by task build:web) ---
/internal/webui/dist/*
!/internal/webui/dist/.gitkeep

# Generated from the installed frontend dependencies before each web build.
/web/static/third-party-licenses.txt

/web/static/third-party-manifest.json
/compliance-output/
/scripts/compliance/__pycache__/
/scripts/__pycache__/
__pycache__/
