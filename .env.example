# Copy to .env for local development (never committed; .env is gitignored).
# Real deployments set these as real environment variables.

# --- Engine state ---
# Writable directory holding the SQLite database (presso.db) and, later,
# engine-generated per-site artifacts.
DATA_DIR=./data

# --- Daemon (cmd/pressod) ---
# 7080 by default: 7000 collides with macOS AirPlay, 7070 with skali.
HTTP_ADDR=:7080
# Keys everything the engine signs or encrypts at rest. Min 32 chars.
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Bearer session lifetime (sessions slide forward on use).
# SESSION_TTL=720h
# Where to reach Docker when it is not the local socket / DOCKER_HOST.
# DOCKER_HOST_OVERRIDE=

# --- Platform (shared containers pressod reconciles) ---
# PLATFORM_MANAGED=false skips creating MariaDB/Redis/edge (you run them).
# PLATFORM_MANAGED=true
# PLATFORM_NETWORK=presso
# MARIADB_IMAGE=mariadb:11.4
# MARIADB_LISTEN=127.0.0.1:3306        # host-side port pressod connects to
# REDIS_IMAGE=redis:7-alpine
# REDIS_LISTEN=127.0.0.1:6379
# REDIS_MAXMEMORY=256mb
# How site containers reach this engine for cache purges (Docker Desktop and
# Linux with host-gateway both resolve host.docker.internal).
# ENGINE_INTERNAL_URL=http://host.docker.internal:7080

# --- Runtime images ---
# RUNTIME_IMAGE_TEMPLATE=presso-runtime:php{php}
# RUNTIME_PHP_VERSIONS=8.3,8.4
# RUNTIME_DEFAULT_PHP=8.3

# --- Edge (Caddy + page cache) ---
# EDGE_IMAGE=presso-edge:dev
# EDGE_HTTP_LISTEN=0.0.0.0:80
# EDGE_HTTPS_LISTEN=0.0.0.0:443
# EDGE_ADMIN_LISTEN=127.0.0.1:2019
# EDGE_CACHE_ADMIN_LISTEN=127.0.0.1:2020
# ACME_EMAIL=                          # for Let's Encrypt on real domains
# EDGE_DEFAULT_CACHE_TTL=12h

# --- Page previews (headless browser) ---
# A shared headless Chrome container captures each site's front page for the
# UI. SHOTS_ENABLED=false skips the container and the previews.
# SHOTS_ENABLED=true
# SHOTS_IMAGE=chromedp/headless-shell:stable
# SHOTS_LISTEN=127.0.0.1:9222          # DevTools port pressod connects to
# SHOTS_INTERVAL=6h                    # background re-capture of running sites
# SHOTS_TIMEOUT=45s

# --- Workers ---
# CRON_INTERVAL=5m                     # wp cron per running site
# STATS_INTERVAL=30s                   # container stats sampling
# METRICS_RETENTION=168h

# --- Logging ---
LOG_LEVEL=info      # debug|info|warn|error
LOG_FORMAT=text     # text|json
