# Copy to .env for local development (never committed; .env is gitignored).
# Real deployments set these as real environment variables.

# --- Engine state ---
# Writable directory holding the SQLite database (presso.db) and, later,
# engine-generated per-site artifacts.
DATA_DIR=./data

# --- Daemon (cmd/pressod) ---
# 7080 by default: 7000 collides with macOS AirPlay, 7070 with skali.
HTTP_ADDR=127.0.0.1:7080
INTERNAL_HTTPS_ADDR=:7081
# Keys everything the engine signs or encrypts at rest. Min 32 chars.
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Bearer session lifetime (sessions slide forward on use).
# SESSION_TTL=720h
# Where to reach Docker when it is not the local socket / DOCKER_HOST.
# DOCKER_HOST_OVERRIDE=

# --- Platform (shared containers pressod reconciles) ---
# PLATFORM_MANAGED=false skips creating MariaDB/Valkey/edge (you run them).
# PLATFORM_MANAGED=true
# PLATFORM_NETWORK=presso
# MariaDB, Valkey and the browser ship with every release, like the edge
# ({release} is the engine's version). Dev builds use the images from
# `task build:services` (required).
# MARIADB_IMAGE=ghcr.io/hinkolas/presso-mariadb:{release}
MARIADB_IMAGE=presso-mariadb:dev
# MARIADB_LISTEN=127.0.0.1:3306        # host-side port pressod connects to
# Valkey is disposable cache, with RDB/AOF persistence disabled.
# Old REDIS_* host settings are rejected; see README.md, Object cache.
# VALKEY_IMAGE=ghcr.io/hinkolas/presso-valkey:{release}
VALKEY_IMAGE=presso-valkey:dev
# VALKEY_LISTEN=127.0.0.1:6379
# VALKEY_MAXMEMORY=256mb
# How site containers reach this engine for cache purges (Docker Desktop and
# Linux with host-gateway both resolve host.docker.internal).
# ENGINE_INTERNAL_URL=https://host.docker.internal:7081

# --- Runtime images ---
# Images are built per release (.github/workflows/release.yml → runtime.yml)
# for the pairs the "build" policy in internal/compat/matrix.json selects and
# carry the release tag: {release} is the engine's own version (v0.1.0),
# {php} is e.g. 8.5, {wp} the pinned WordPress release e.g. 6.9.7. Updating
# the engine therefore moves every site to that release's images.
# RUNTIME_IMAGE_TEMPLATE=ghcr.io/hinkolas/presso-runtime:{release}-php{php}-wp{wp}
# A dev build (v0.0.0-dev) has no release, so development runs against images
# built locally with `task build:runtime` (required; the default refuses to
# start otherwise):
RUNTIME_IMAGE_TEMPLATE=presso-runtime:php{php}-wp{wp}
# Legacy (nginx + PHP-FPM, PHP 7.4-8.1) is disabled: its base images carry no
# fix for CVE-2026-109618/109619 and releases publish no legacy pairs, so true
# has no effect on released images. Only pairs published by the build policy
# are offered. See "Legacy runtimes" in README.md.
# RUNTIME_LEGACY_ENABLED=false
# WordPress branch preselected for new sites; empty = newest in the matrix.
# RUNTIME_DEFAULT_WP=
# Optional allowlist of PHP versions to offer; empty = every shipped version.
# RUNTIME_PHP_VERSIONS=

# --- Edge (Caddy + page cache) ---
# Published with every release; {release} is the engine's version. Dev builds
# use the image from `task build:edge` (required, like the runtime template).
# EDGE_IMAGE=ghcr.io/hinkolas/presso-edge:{release}
EDGE_IMAGE=presso-edge:dev
# EDGE_HTTP_LISTEN=0.0.0.0:80
# EDGE_HTTPS_LISTEN=0.0.0.0:443
# ACME_EMAIL=                          # for Let's Encrypt on real domains
# EDGE_DEFAULT_CACHE_TTL=12h
# EDGE_STALE_FOR=24h                   # expired pages kept for stale-while-revalidate / stale-if-error (>= 24h)

# --- Panel ---
# Hostname the edge serves the admin UI on (TLS via ACME, proxied to the
# internal HTTPS listener using a client certificate). The local panel always
# binds a loopback IP, even when no domain is configured.
# PANEL_DOMAIN=

# --- Self-update ---
# The engine polls GitHub Releases for the channel chosen under Settings →
# Updates (stable, or beta for alpha/beta/rc releases too), where automatic
# updates can also be turned on. UPDATE_CHECK=false stops the background check
# and automatic updates; checking and updating by hand still work.
# UPDATE_CHECK=true
# UPDATE_CHANNEL=         # channel before the panel setting is first saved
#                         # (stable or beta; empty: the running build's)
# UPDATE_CHECK_INTERVAL=6h
# UPDATE_REPO=Hinkolas/presso
# UPDATE_API_URL=https://api.github.com   # point at a fake feed to test the flow

# --- Page previews (headless browser) ---
# A shared headless Chrome container captures each site's front page for the
# UI. SHOTS_ENABLED=false skips the container and the previews.
# SHOTS_ENABLED=true
# Must provide presso-browser (Chromium's headless shell) and socat.
# SHOTS_IMAGE=ghcr.io/hinkolas/presso-browser:{release}
SHOTS_IMAGE=presso-browser:dev
# SHOTS_INTERVAL=6h                    # background re-capture of running sites
# SHOTS_TIMEOUT=45s

# --- Workers ---
# CRON_INTERVAL=5m                     # wp cron per running site
# Sitemap cache warmer; sites opt in with their "Keep the cache warm" setting.
# A walk over still-cached pages is pure edge hits, so keep the interval below
# the page TTL (above it, pages go cold between walks).
# WARM_INTERVAL=1h
# WARM_TIMEOUT=20s                     # per request through the edge
# WARM_MAX_URLS=2000                   # per site and run
# STATS_INTERVAL=30s                   # container stats sampling
# METRICS_RETENTION=168h

# --- Logging ---
LOG_LEVEL=info      # debug|info|warn|error
LOG_FORMAT=text     # text|json
