# Keep the image build context lean (build/pressod.Dockerfile builds from
# the repo root). Only the Go sources matter to that image.
.git
bin/
data/
web/node_modules/
web/.svelte-kit/
web/build/
.env
.env.*
!.env.example
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.db
**/*.db-*
**/*.sqlite*
**/*.dump
**/*.sql.gz
**/*.sql.zst
**/*.bak
.aws/
.ssh/
.agents/
.codex/
.claude/
secrets/
backups/
compliance-output/
dist/
gitleaks*.json
gitleaks*.sarif
**/__pycache__/
*.log
